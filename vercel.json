{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/backend.py": {
      "maxDuration": 30,
      "memory": 1024,
      "excludeFiles": "{web/node_modules,node_modules,web/src,web/dist,tests,.git,.tools,.publish,public}/**"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/backend?__p=/admin" },
    { "source": "/admin/", "destination": "/api/backend?__p=/admin" },
    { "source": "/admin/:path*", "destination": "/api/backend?__p=/admin/:path*" },
    { "source": "/api/:path*", "destination": "/api/backend?__p=/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/backend?__p=/uploads/:path*" },
    { "source": "/((?!api/|admin/?|images/|css/|js/|videos/|fonts/|uploads/).*)", "destination": "/index.html" }
  ]
}
